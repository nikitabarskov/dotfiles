mise_args := ""

mise-clean:
    mise prune {{ mise_args }} --yes && \
    mise cache {{ mise_args }} clean && \
    mise cache {{ mise_args }} prune

mise-install: && mise-clean
    mise install {{ mise_args }}

mise-self-update:
    mise self-update --yes --quiet

mise-upgrade target="": mise-self-update && mise-clean
    mise upgrade {{ mise_args }} --global --prune --bump {{ target }}

mise-lock:
    mise lock {{ mise_args }} --global

mise-use tool:
    mise use {{ mise_args }} --global {{ tool }}

fix:
    mise fmt --cd ${HOME}/.config/mise
