{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__codegraph",
      "mcp__fff",
      "mcp__headroom",
      "mcp__inspect",
      "mcp__sem",
      "mcp__tokensave"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Agent|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "tokensave",
            "args": ["hook-pre-tool-use"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tokensave",
            "args": ["hook-prompt-submit"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tokensave",
            "args": ["hook-stop"]
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "auto",
  "editorMode": "normal"
}
